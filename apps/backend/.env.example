# If using a serverless Postgres provider that auto-suspends when idle
# (e.g. Neon free tier), add &connect_timeout=30 so Prisma waits for it to
# wake up instead of failing with "Can't reach database server" (P1001).
# If the host has "-pooler" in it (PgBouncer), also add
# &pgbouncer=true&connection_limit=5 or Prisma's connection pool exhausts
# fast ("Timed out fetching a new connection from the pool").
DATABASE_URL="postgresql://prqms_user:prqms_pass@localhost:5432/prqms?schema=public"
PORT=4000
# Must be 32+ random characters — the server refuses to start in production otherwise.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated browser origins allowed to call the API (required in production).
# Dev defaults cover localhost/127.0.0.1 on ports 5173 and 5300.
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Render/Railway/Nginx = 1), so
# rate limiting sees real client IPs. Leave 0 when running directly.
TRUST_PROXY=0
# Seed-only defaults for the two staff accounts created by `npm run db:seed`
# (admin@prqms.local / tech@prqms.local) — change both after first login.
DEFAULT_ADMIN_PASSWORD="admin1234"
DEFAULT_TECHNICIAN_PASSWORD="tech1234"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIN_ENCRYPTION_KEY="replace-with-a-generated-64-char-hex-string"

# Ready-for-Pickup email notifications (boilerplate — leave unset to just
# log what would be sent instead of actually emailing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL="no-reply@example.com"
ADMIN_NOTIFY_EMAIL=
PUBLIC_APP_URL="http://localhost:5173"

# Telegram Ready-for-Pickup notifications (boilerplate — leave TELEGRAM_BOT_TOKEN
# unset to just log what would be sent, same as the email stub above).
# Create a bot via @BotFather to get the token; TELEGRAM_BOT_USERNAME (no
# @) is the bot's public @handle, used to build the t.me/<username>?start=
# deep link customers tap to link their chat — the Bot API can't message a
# phone number or @username directly, only a chat_id obtained this way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
